{
  "name": "timeline-ng",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run",
    "dev": "pnpm -r --parallel dev",
    "authoring": "pnpm --filter @timeline-ng/authoring dev",
    "authoring:devnet": "pnpm --filter @timeline-ng/authoring dev:devnet",
    "embed": "pnpm --filter @timeline-ng/embed dev",
    "og-preview": "pnpm --filter @timeline-ng/og-preview dev",
    "contrast-lab": "pnpm --filter @timeline-ng/contrast-lab dev",
    "typecheck": "pnpm -r typecheck",
    "fonts:extract": "node scripts/fonts/extract-tl3-pairings.mjs && node scripts/fonts/generate-pairings.mjs",
    "fonts:fetch": "node scripts/fonts/fetch-fonts.mjs && node scripts/fonts/fetch-licenses.mjs",
    "docs:tokens": "node scripts/docs/generate-token-reference.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
