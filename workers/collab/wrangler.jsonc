{
  // No `env` block, and that is deliberate rather than unfinished.
  //
  // This worker has no authentication: the route accepts any draft id and
  // opens a room on it, so deploying it anywhere reachable would publish an
  // open collaboration relay. Stage 1 of docs/phase2-plan.md adds the
  // identity check ([P4] — atproto service auth); add an environment then,
  // and restore `deploy` in package.json with it.
  //
  // `wrangler dev` is unaffected and is how this is meant to be run today.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timeline-collab",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "vars": {
    // Our own identity ([P26]) and the one method we accept ([P27]). A token
    // minted for any other audience or method is refused.
    "SERVICE_DID": "did:web:drafts.devnet.internal#collab",
    "SERVICE_LXM": "com.knightlab.drafts.connect",
    // Local dev default: the devnet PLC. Production resolves against the real
    // directory, so this is overridden per environment when one exists.
    "PLC_URL": "http://localhost:2582"
  },
  "durable_objects": {
    "bindings": [
      { "name": "DRAFT", "class_name": "DraftRoom" }
    ]
  },
  "migrations": [
    // SQLite-backed, which is what the free plan allows and the right choice
    // here regardless — see docs/phase2-plan.md §10.8.
    { "tag": "v1", "new_sqlite_classes": ["DraftRoom"] }
  ]
}
