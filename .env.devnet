# Safe defaults for local devnet — safe to commit, no real secrets.
# Copy to .env or export before running devnet scripts, or pass via --env-file.

DEVNET_DB_USER=postgres
DEVNET_DB_PASSWORD=postgres
DEVNET_DB_NAME=plc

# Host port for postgres (5432 is often in use locally)
DEVNET_POSTGRES_PORT=5433

# PDS at :3000, PLC at :2582 (devnet defaults)
# Host port only — Caddy reaches the PDS at http://pds:3000 inside the Docker
# network, so this affects direct localhost access and nothing else. Moved off
# 3000 because that is a popular default and another local atproto devnet will
# take it, which fails as "Bind for 0.0.0.0:3000 failed: port is already
# allocated" when this stack comes up second.
DEVNET_PDS_PORT=3001
DEVNET_PLC_PORT=2582
DEVNET_PDS_HOSTNAME=devnet.internal
MKCERT_CAROOT=/Users/germuska/Library/Application Support/mkcert

# MailDev web UI and SMTP
DEVNET_MAILDEV_WEB_PORT=1081
DEVNET_MAILDEV_SMTP_PORT=1026

# Jetstream WebSocket
# Also a host port only, and also moved off a default another local devnet
# takes. Nothing in this project connects to jetstream — it is here for
# inspecting the firehose by hand.
DEVNET_JETSTREAM_PORT=6010
# Jetstream publishes a second port for metrics, defaulting to 6009. It was not
# set here, so it kept the default and collided even after the first was moved.
DEVNET_JETSTREAM_METRICS_PORT=6011
# Same again for TAP. Between them, PDS, jetstream and TAP publish five host
# ports whose defaults any other local atproto devnet also claims.
DEVNET_TAP_PORT=2481
